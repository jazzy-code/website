# Public site URL (canonical, sitemap, hreflang, Open Graph).
# Optional: builds default to https://jazzycode.com and `pnpm dev` to
# http://localhost:3000. Set it only to point the metadata at another domain.
NEXT_PUBLIC_SITE_URL=
# Contact email shown on the contact page and footer.
# Optional: defaults to hello@jazzycode.com (src/config/site.ts).
NEXT_PUBLIC_CONTACT_EMAIL=
# Show the demo clients and reviews (src/content/mock.ts) outside `pnpm dev`,
# e.g. on a Vercel preview. Leave unset in production.
NEXT_PUBLIC_MOCK_CONTENT=
