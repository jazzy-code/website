# Public site URL (canonical, sitemap, hreflang, Open Graph).
# Optional on Vercel: if empty, the production URL Vercel provides is used.
# Set it to the final custom domain once there is one, e.g. https://jazzycode.com
NEXT_PUBLIC_SITE_URL=
# Contact email shown on the contact page and footer.
# Optional: if empty, the temporary test address in src/config/site.ts is used.
NEXT_PUBLIC_CONTACT_EMAIL=
